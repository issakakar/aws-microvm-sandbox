# Copy to .env (gitignored) and fill in locally. NEVER commit real secrets.

# ── AWS control-plane (SigV4: RunMicrovm, CreateMicrovmAuthToken, ...) ──
# Preferred: configure a profile instead of putting raw keys here:
#   aws configure --profile microvm-bench
AWS_PROFILE=microvm-bench
AWS_REGION=us-east-1

# ── Harness overrides (optional) ──
# Override the provisioner Function URLs for local testing (e.g. after `terraform apply`).
# The harness reads these from harness/urls.json / Terraform outputs by default; set here to bypass.
# HARNESS_URL_USE1=https://xxxxxxxx.lambda-url.us-east-1.on.aws/
# HARNESS_URL_USW2=https://xxxxxxxx.lambda-url.us-west-2.on.aws/

# ── Image build overrides (optional) ──
# ACCOUNT_ID is auto-derived via `aws sts get-caller-identity`; set only to override.
# BUILD_ROLE_ARN=arn:aws:iam::<account-id>:role/microvm-bench-build-role
# POLL_INTERVAL_S=30
